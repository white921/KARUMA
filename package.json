{
  "name": "levelia-bot",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/index.js",
    "register": "node dist/registerCommands.js",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "dayjs": "^1.11.19",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.1",
    "mysql2": "^3.9.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/mysql": "^2.15.25",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.5.4"
  }
}
